# astro-tools configuration. Read by every astro-tools command.
# Installed copy lives at ~/.config/astro-tools/config

# The archive drive (Targets/, MANIFEST.sha256, ...)
ASTRO_ARCHIVE=/Volumes/Astro

# Where astro-backup copies the archive to: host:/path over SSH (an ~/.ssh/config alias),
# or a mounted folder such as /Volumes/home/Astrophotography
ASTRO_NAS=atlas:/volume1/homes/theresa/Astrophotography
